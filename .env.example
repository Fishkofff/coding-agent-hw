# Скопируйте в .env (он в .gitignore) и подставьте свои значения.
# Подойдёт любой OpenAI-compatible Chat Completions API с поддержкой tool calling.

# финальные eval: ProxyAPI (оплата в рублях)
OPENAI_BASE_URL=https://openai.api.proxyapi.ru/v1
OPENAI_API_KEY=<ваш ключ>
OPENAI_MODEL=openai/gpt-4.1-mini

# локальная Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1/
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3:4b
# OPENAI_NO_THINK=1
